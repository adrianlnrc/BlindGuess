# ---------------------------------------------------------------- Google Maps
# Chave usada no navegador (Street View + mapas). Fica exposta no HTML: restrinja
# por HTTP referrer no Google Cloud Console.
# ATENCAO: e embutida no bundle em tempo de BUILD. Mudou a chave? refaca o deploy.
# APIs necessarias: Maps JavaScript API, Street View Static API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Chave usada no servidor para validar panoramas. Pode ser a mesma acima, mas o
# ideal e uma chave separada restrita por IP.
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------- Banco
# Postgres. No Railway, referencie a variavel do servico: ${{ Postgres.DATABASE_URL }}
# Sem isso o jogo roda, mas sem login, ranking, streak nem desafio.
DATABASE_URL=

# --------------------------------------------------------------- Autenticacao
# Segredo que assina os cookies de sessao. Gere com: openssl rand -base64 32
AUTH_SECRET=

# Login com Google (opcional). Crie um OAuth Client ID do tipo "Web application"
# no mesmo projeto do Google Cloud e autorize o redirect:
#   https://SEU-DOMINIO/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic link por e-mail (opcional). Chave da API do Resend e o remetente.
# Para testar da para usar onboarding@resend.dev; em producao, verifique um dominio seu.
AUTH_RESEND_KEY=
EMAIL_FROM=

# ------------------------------------------------------------------- Geral
# Porta do servidor (o Railway define sozinho)
PORT=3000

# Fuso que define a virada do dia no streak
BLINDGUESS_TIMEZONE=America/Sao_Paulo
