# Chave da Google Maps JavaScript API (exposta ao browser — restrinja por HTTP referrer no console)
# APIs necessarias: Maps JavaScript API, Street View Static API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Chave usada no servidor para validar panoramas via Street View Metadata API.
# Pode ser a mesma chave acima, mas o ideal e uma chave separada restrita por IP.
GOOGLE_MAPS_API_KEY=

# Porta do servidor (padrao 3000)
PORT=3000
